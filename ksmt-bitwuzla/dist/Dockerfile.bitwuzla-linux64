ARG BASE_REGISTRY=docker.io

FROM ${BASE_REGISTRY}/library/ubuntu:22.04@sha256:08ea48a03a3e78ebc7cd526e6a275053223aadd88bfc09cc49b06d5281525fde AS build

ARG BITWUZLA_COMMIT=1230d80a5275ddf525da9c218c2bcd29c3130e49
ARG BITWUZLA_SHA256=3639b4bb8c4e832514fe45456ac12c1e1a87af2d66f67518a82ab3014ac90b9b
ARG GMP_VERSION=6.3.0
ARG GMP_SHA256=a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      binutils build-essential ca-certificates cmake curl git m4 patch python3 unzip xz-utils zip \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN curl -fsSL -o gmp.tar.xz "https://ftp.gnu.org/gnu/gmp/gmp-${GMP_VERSION}.tar.xz" \
 && echo "${GMP_SHA256}  gmp.tar.xz" | sha256sum -c - \
 && tar xf gmp.tar.xz \
 && cd "gmp-${GMP_VERSION}" \
 && ./configure --prefix=/build/deps --disable-shared --enable-static --with-pic --enable-fat --enable-cxx \
 && make -j"$(nproc)" \
 && make install

RUN curl -fsSL -o bitwuzla.tar.gz "https://github.com/bitwuzla/bitwuzla/archive/${BITWUZLA_COMMIT}.tar.gz" \
 && echo "${BITWUZLA_SHA256}  bitwuzla.tar.gz" | sha256sum -c - \
 && tar xzf bitwuzla.tar.gz \
 && mv "bitwuzla-${BITWUZLA_COMMIT}" bitwuzla

COPY bitwuzla-gh31.patch /build/
RUN cd bitwuzla && patch -p1 < /build/bitwuzla-gh31.patch

RUN cd bitwuzla \
 && ./contrib/setup-cadical.sh \
 && ./contrib/setup-btor2tools.sh \
 && ./contrib/setup-symfpu.sh

RUN cd bitwuzla \
 && LDFLAGS="-static-libstdc++ -static-libgcc" ./configure.sh production --shared --only-cadical --path /build/deps \
 && cd build \
 && make -j"$(nproc)"

COPY bitwuzla-linux64-1.0.zip /build/original.zip
RUN mkdir original out \
 && unzip -q original.zip -d original \
 && lib=/build/bitwuzla/build/lib/libbitwuzla.so \
 && needed=$(objdump -p "$lib" | awk '/NEEDED/ { print $2 }' | grep -v '^ld-linux' | sort | tr '\n' ' ') \
 && [ "$needed" = "libc.so.6 libm.so.6 " ] \
 && ! nm -D --undefined-only "$lib" | grep -q -i gmp \
 && nm -D --undefined-only original/libbitwuzla_jni.so | awk '{ print $NF }' | grep -E '^(bzla|bitwuzla)_' | sort -u > needed.txt \
 && nm -D --defined-only "$lib" | awk '{ print $NF }' | sort -u > defined.txt \
 && missing=$(comm -23 needed.txt defined.txt) \
 && [ -z "$missing" ] \
 && cp "$lib" original/libbitwuzla.so \
 && (cd original && zip -q -X ../out/bitwuzla-linux64-1.0.zip libbitwuzla.so libbitwuzla_jni.so) \
 && sha256sum "$lib" | awk '{ print $1 }' > out/libbitwuzla.so.sha256

FROM scratch AS out
COPY --from=build /build/out/ /
